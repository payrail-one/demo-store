{
  "name": "@payrail-one/demo-store",
  "private": true,
  "version": "0.1.0",
  "description": "Full-stack Workstar and Go reference storefront for Payrail checkout.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "check": "tsc --project frontend/tsconfig.json --noEmit",
    "build": "vite build --config frontend/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@payrail-one/sdk": "https://github.com/payrail-one/sdk/archive/8a837328d3234505bf06e55ccd11cb3ccaca7fa5.tar.gz",
    "uqr": "0.1.3",
    "workstar": "0.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.147.0"
  }
}
